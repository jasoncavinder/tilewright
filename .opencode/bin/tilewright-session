#!/usr/bin/env bash
set -euo pipefail

PROGRAM="$(basename "$0")"
BRANCH_PREFIX="${TILEWRIGHT_WORKTREE_BRANCH_PREFIX:-work/}"
OPENCODE_BIN="${OPENCODE_BIN:-opencode}"

usage() {
  cat <<USAGE
Usage:
  $PROGRAM new <slug> [--base <ref>] [-- <opencode arguments...>]
  $PROGRAM create <slug> [--base <ref>]
  $PROGRAM open <slug> [-- <opencode arguments...>]
  $PROGRAM check [--write]
  $PROGRAM list
  $PROGRAM path <slug>
  $PROGRAM retire <slug> [--base <ref>]

Commands:
  new      Create a dedicated worktree and launch OpenCode in it.
  create   Create a dedicated worktree without launching OpenCode.
  open     Launch OpenCode in an existing session worktree.
  check    Report session isolation; --write fails unless writes are safe.
  list     Show Git worktrees and active OpenCode session locks.
  path     Print the worktree path for a session slug.
  retire   Safely remove a clean worktree whose branch is merged into base.

Environment:
  TILEWRIGHT_WORKTREE_ROOT          Override the worktree parent directory.
  TILEWRIGHT_WORKTREE_BRANCH_PREFIX Override the branch prefix (default: work/).
  OPENCODE_BIN                      Override the OpenCode executable.
USAGE
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

require_repo() {
  git rev-parse --show-toplevel >/dev/null 2>&1 || die "run this inside a Tilewright Git checkout"
}

absolute_common_dir() {
  local top raw
  top="$(git rev-parse --show-toplevel)"
  raw="$(git rev-parse --git-common-dir)"
  case "$raw" in
    /*) printf '%s\n' "$raw" ;;
    *)  (cd "$top/$raw" && pwd -P) ;;
  esac
}

init_context() {
  require_repo
  CURRENT_ROOT="$(git rev-parse --show-toplevel)"
  GIT_DIR="$(git rev-parse --absolute-git-dir)"
  COMMON_DIR="$(absolute_common_dir)"
  PRIMARY_ROOT="$(cd "$(dirname "$COMMON_DIR")" && pwd -P)"

  local requested_root
  requested_root="${TILEWRIGHT_WORKTREE_ROOT:-$(dirname "$PRIMARY_ROOT")/tilewright-worktrees}"
  mkdir -p "$requested_root"
  WORKTREE_ROOT="$(cd "$requested_root" && pwd -P)"

  case "$WORKTREE_ROOT/" in
    "$PRIMARY_ROOT"/*)
      die "worktree root must be outside the primary checkout: $PRIMARY_ROOT"
      ;;
  esac
}

validate_slug() {
  local slug="$1"
  case "$slug" in
    ""|-*|*-|*[!a-z0-9-]*)
      die "slug must use lowercase letters, digits, and interior hyphens"
      ;;
  esac
  [ "${#slug}" -le 64 ] || die "slug must be 64 characters or fewer"
}

branch_for_slug() {
  printf '%s%s\n' "$BRANCH_PREFIX" "$1"
}

default_base() {
  if git -C "$PRIMARY_ROOT" show-ref --verify --quiet refs/heads/main; then
    printf 'main\n'
  else
    printf 'HEAD\n'
  fi
}

worktree_for_branch() {
  local branch="$1"
  git -C "$PRIMARY_ROOT" worktree list --porcelain | awk -v wanted="refs/heads/$branch" '
    /^worktree / { path = substr($0, 10) }
    /^branch / && substr($0, 8) == wanted { print path; exit }
  '
}

worktree_for_slug() {
  local branch path
  branch="$(branch_for_slug "$1")"
  path="$(worktree_for_branch "$branch")"
  [ -n "$path" ] || return 1
  printf '%s\n' "$path"
}

lock_dir_for_slug() {
  printf '%s/opencode-session-locks/%s\n' "$COMMON_DIR" "$1"
}

lock_is_active() {
  local lock_dir="$1" pid
  [ -d "$lock_dir" ] || return 1
  [ -f "$lock_dir/pid" ] || return 1
  pid="$(cat "$lock_dir/pid" 2>/dev/null || true)"
  case "$pid" in
    ''|*[!0-9]*) return 1 ;;
  esac
  kill -0 "$pid" 2>/dev/null
}

acquire_lock() {
  local slug="$1" path="$2" lock_dir pid
  lock_dir="$(lock_dir_for_slug "$slug")"
  mkdir -p "$(dirname "$lock_dir")"

  if ! mkdir "$lock_dir" 2>/dev/null; then
    if lock_is_active "$lock_dir"; then
      pid="$(cat "$lock_dir/pid")"
      die "session '$slug' is already open under launcher PID $pid"
    fi
    printf 'Removing stale session lock for %s.\n' "$slug" >&2
    rm -rf "$lock_dir"
    mkdir "$lock_dir"
  fi

  printf '%s\n' "$$" > "$lock_dir/pid"
  printf '%s\n' "$path" > "$lock_dir/worktree"
  date -u '+%Y-%m-%dT%H:%M:%SZ' > "$lock_dir/started-at"

  SESSION_LOCK_DIR="$lock_dir"
}

release_lock() {
  if [ -n "${SESSION_LOCK_DIR:-}" ] && [ -d "$SESSION_LOCK_DIR" ]; then
    local owner
    owner="$(cat "$SESSION_LOCK_DIR/pid" 2>/dev/null || true)"
    if [ "$owner" = "$$" ]; then
      rm -rf "$SESSION_LOCK_DIR"
    fi
  fi
}

create_worktree() {
  local slug="$1" base="$2" branch path
  validate_slug "$slug"
  branch="$(branch_for_slug "$slug")"
  path="$WORKTREE_ROOT/$slug"

  git -C "$PRIMARY_ROOT" rev-parse --verify "${base}^{commit}" >/dev/null 2>&1 \
    || die "base ref does not resolve to a commit: $base"

  if git -C "$PRIMARY_ROOT" show-ref --verify --quiet "refs/heads/$branch"; then
    die "branch already exists: $branch (use '$PROGRAM open $slug')"
  fi
  [ ! -e "$path" ] || die "worktree path already exists: $path"

  git -C "$PRIMARY_ROOT" worktree add -b "$branch" "$path" "$base"
  printf 'Created %s at %s from %s.\n' "$branch" "$path" "$base"
  CREATED_PATH="$path"
}

launch_worktree() {
  local slug="$1" path="$2"
  shift 2

  command -v "$OPENCODE_BIN" >/dev/null 2>&1 || die "OpenCode executable not found: $OPENCODE_BIN"
  acquire_lock "$slug" "$path"
  trap release_lock EXIT HUP INT TERM

  export TILEWRIGHT_OPENCODE_MANAGED=1
  export TILEWRIGHT_SESSION_SLUG="$slug"
  export TILEWRIGHT_SESSION_LOCK_DIR="$SESSION_LOCK_DIR"
  export TILEWRIGHT_SESSION_LOCK_PID="$$"

  printf 'Launching OpenCode session %s in %s\n' "$slug" "$path"
  (
    cd "$path"
    "$OPENCODE_BIN" "$@"
  )
}

parse_base_and_args() {
  BASE="$(default_base)"
  OPENCODE_ARGS=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --base)
        [ "$#" -ge 2 ] || die "--base requires a ref"
        BASE="$2"
        shift 2
        ;;
      --)
        shift
        OPENCODE_ARGS=("$@")
        return
        ;;
      *)
        die "unexpected argument: $1"
        ;;
    esac
  done
}

check_session() {
  local require_write=0 linked=0 managed=0 branch lock_valid=0
  if [ "${1:-}" = "--write" ]; then
    require_write=1
  elif [ "$#" -gt 0 ]; then
    die "check accepts only --write"
  fi

  branch="$(git branch --show-current)"
  [ "$GIT_DIR" != "$COMMON_DIR" ] && linked=1
  [ "${TILEWRIGHT_OPENCODE_MANAGED:-0}" = "1" ] && managed=1

  if [ -n "${TILEWRIGHT_SESSION_LOCK_DIR:-}" ] \
    && [ -d "$TILEWRIGHT_SESSION_LOCK_DIR" ] \
    && [ "$(cat "$TILEWRIGHT_SESSION_LOCK_DIR/pid" 2>/dev/null || true)" = "${TILEWRIGHT_SESSION_LOCK_PID:-}" ] \
    && kill -0 "${TILEWRIGHT_SESSION_LOCK_PID:-0}" 2>/dev/null; then
    lock_valid=1
  fi

  printf 'checkout=%s\n' "$CURRENT_ROOT"
  printf 'branch=%s\n' "${branch:-DETACHED}"
  printf 'linked_worktree=%s\n' "$([ "$linked" -eq 1 ] && printf yes || printf no)"
  printf 'managed_launcher=%s\n' "$([ "$managed" -eq 1 ] && printf yes || printf no)"
  printf 'session_lock=%s\n' "$([ "$lock_valid" -eq 1 ] && printf valid || printf missing-or-invalid)"

  if [ "$linked" -eq 1 ] \
    && [ "$managed" -eq 1 ] \
    && [ "$lock_valid" -eq 1 ] \
    && [ -n "$branch" ] \
    && [ "${branch#"$BRANCH_PREFIX"}" != "$branch" ]; then
    printf 'write_isolation=ready\n'
    return 0
  fi

  printf 'write_isolation=not-ready\n'
  if [ "$require_write" -eq 1 ]; then
    printf 'Launch writable sessions with: .opencode/bin/%s new <slug>\n' "$PROGRAM" >&2
    return 2
  fi
}

list_sessions() {
  local lock_root lock pid state slug
  git -C "$PRIMARY_ROOT" worktree list
  printf '\nOpenCode session locks:\n'
  lock_root="$COMMON_DIR/opencode-session-locks"
  if [ ! -d "$lock_root" ]; then
    printf '  (none)\n'
    return
  fi

  for lock in "$lock_root"/*; do
    [ -d "$lock" ] || continue
    slug="$(basename "$lock")"
    pid="$(cat "$lock/pid" 2>/dev/null || true)"
    if lock_is_active "$lock"; then state=active; else state=stale; fi
    printf '  %-24s pid=%-8s %s\n' "$slug" "${pid:-unknown}" "$state"
  done
}

retire_worktree() {
  local slug="$1" base="$2" branch path lock_dir status current
  validate_slug "$slug"
  branch="$(branch_for_slug "$slug")"
  path="$(worktree_for_slug "$slug")" || die "no worktree found for branch $branch"
  lock_dir="$(lock_dir_for_slug "$slug")"

  [ "$CURRENT_ROOT" = "$PRIMARY_ROOT" ] \
    || die "retire sessions from the primary checkout: $PRIMARY_ROOT"
  if lock_is_active "$lock_dir"; then
    die "session '$slug' is still open"
  fi

  status="$(git -C "$path" status --porcelain --untracked-files=normal)"
  [ -z "$status" ] || die "worktree has uncommitted or untracked changes: $path"

  git -C "$PRIMARY_ROOT" rev-parse --verify "${base}^{commit}" >/dev/null 2>&1 \
    || die "base ref does not resolve to a commit: $base"
  git -C "$PRIMARY_ROOT" merge-base --is-ancestor "$branch" "$base" \
    || die "branch $branch is not fully merged into $base"

  current="$(git -C "$path" branch --show-current)"
  [ "$current" = "$branch" ] || die "worktree branch mismatch: expected $branch, found ${current:-DETACHED}"

  git -C "$PRIMARY_ROOT" worktree remove "$path"
  git -C "$PRIMARY_ROOT" branch -d "$branch"
  [ ! -d "$lock_dir" ] || rm -rf "$lock_dir"
  printf 'Retired %s and removed %s.\n' "$branch" "$path"
}

main() {
  [ "$#" -gt 0 ] || { usage; exit 1; }
  init_context

  local command="$1"
  shift
  case "$command" in
    new)
      [ "$#" -gt 0 ] || die "new requires a slug"
      local slug="$1"
      shift
      parse_base_and_args "$@"
      create_worktree "$slug" "$BASE"
      launch_worktree "$slug" "$CREATED_PATH" "${OPENCODE_ARGS[@]}"
      ;;
    create)
      [ "$#" -gt 0 ] || die "create requires a slug"
      local slug="$1"
      shift
      parse_base_and_args "$@"
      [ "${#OPENCODE_ARGS[@]}" -eq 0 ] || die "create does not accept OpenCode arguments"
      create_worktree "$slug" "$BASE"
      ;;
    open)
      [ "$#" -gt 0 ] || die "open requires a slug"
      local slug="$1" path
      shift
      validate_slug "$slug"
      if [ "${1:-}" = "--" ]; then shift; fi
      path="$(worktree_for_slug "$slug")" || die "no worktree found for session '$slug'"
      launch_worktree "$slug" "$path" "$@"
      ;;
    check)
      check_session "$@"
      ;;
    list)
      [ "$#" -eq 0 ] || die "list accepts no arguments"
      list_sessions
      ;;
    path)
      [ "$#" -eq 1 ] || die "path requires exactly one slug"
      validate_slug "$1"
      worktree_for_slug "$1" || die "no worktree found for session '$1'"
      ;;
    retire)
      [ "$#" -gt 0 ] || die "retire requires a slug"
      local slug="$1"
      shift
      parse_base_and_args "$@"
      [ "${#OPENCODE_ARGS[@]}" -eq 0 ] || die "retire does not accept OpenCode arguments"
      retire_worktree "$slug" "$BASE"
      ;;
    -h|--help|help)
      usage
      ;;
    *)
      usage >&2
      die "unknown command: $command"
      ;;
  esac
}

main "$@"
