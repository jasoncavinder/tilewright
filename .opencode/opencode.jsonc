{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "tilewright",
  "share": "disabled",
  "lsp": true,
  "compaction": {
    "auto": true,
    "prune": true
  },
  "watcher": {
    "ignore": [
      ".git/**",
      ".local-research/**",
      ".worktrees/**",
      "target/**",
      "**/target/**",
      ".cargo-target/**",
      "**/*.log",
      "artifacts/**"
    ]
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "ask",
      ".local-research/**": "deny",
      ".local-research/workspaces/**": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "skill": "allow",
    "task": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": "deny",
    "doom_loop": "ask",
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "ls": "allow",
      "ls *": "allow",
      "find *": "allow",
      "rg *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "date -u*": "allow",
      "mkdir -p .worktrees": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch --show-current*": "allow",
      "git rev-parse*": "allow",
      "git ls-files*": "allow",
      "git grep*": "allow",
      "git worktree list*": "allow",
      "git add": "allow",
      "git add *": "allow",
      "cargo --version*": "allow",
      "rustc --version*": "allow",
      "rust-analyzer --version*": "allow",
      "cargo metadata*": "allow",
      "cargo tree*": "allow",
      "cargo check*": "allow",
      "cargo test*": "allow",
      "cargo clippy*": "allow",
      "cargo fmt --all --check*": "allow",
      "cargo doc*": "allow",
      "git commit": "allow",
      "git commit *": "allow",
      "git push": "deny",
      "git push *": "deny",
      "git reset": "deny",
      "git reset *": "deny",
      "git clean": "deny",
      "git clean *": "deny",
      "git restore": "deny",
      "git restore *": "deny",
      "git checkout*": "deny",
      "git switch*": "deny",
      "git merge*": "deny",
      "git merge-base*": "allow",
      "git rebase*": "deny",
      "git cherry-pick*": "deny",
      "git branch -d*": "allow",
      "git branch -D*": "deny",
      "git branch -m*": "deny",
      "git branch -M*": "deny",
      "git worktree add*": "allow",
      "git worktree remove*": "allow",
      "git worktree move*": "deny",
      "git worktree prune*": "deny",
      "git worktree lock*": "deny",
      "git worktree unlock*": "deny",
      "git worktree repair*": "deny",
      "git worktree *--force*": "deny",
      "git worktree * -f*": "deny",
      "git add *--force*": "deny",
      "git add * -f*": "deny",
      "cargo publish": "deny",
      "cargo publish *": "deny",
      "rm": "deny",
      "rm *": "deny"
    }
  }
}
